<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.fragment.HomeFragment">

    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MapsActivity" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="260dp"
        android:background="@drawable/panel_background_rounded_shape"
        android:clipToPadding="false"
        android:paddingTop="10dp"
        android:visibility="visible" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/earthquakeDetailsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/earthquake_detail_sheet_background"
        android:elevation="12dp"
        android:minHeight="440dp"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp"
        android:visibility="invisible"
        app:behavior_hideable="true"
        app:behavior_peekHeight="104dp"
        app:behavior_skipCollapsed="false"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:id="@+id/detailDragHandle"
            android:layout_width="44dp"
            android:layout_height="4dp"
            android:background="@drawable/earthquake_detail_drag_handle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/earthquake_detail_icon_button_background"
            android:contentDescription="Back to earthquake list"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/back_arrow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/detailDragHandle" />

        <TextView
            android:id="@+id/magTV"
            android:layout_width="56dp"
            android:layout_height="36dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/earthquake_detail_magnitude_pill"
            android:gravity="center"
            android:text="4.2"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/backButton"
            app:layout_constraintStart_toEndOf="@id/backButton"
            app:layout_constraintTop_toTopOf="@id/backButton" />

        <TextView
            android:id="@+id/countryTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Malatya, Turkey"
            android:textColor="@color/earthquake_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/detailLocationSubtitleTV"
            app:layout_constraintEnd_toStartOf="@id/minutesPassedTV"
            app:layout_constraintStart_toEndOf="@id/magTV"
            app:layout_constraintTop_toTopOf="@id/backButton"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/detailLocationSubtitleTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Selected earthquake"
            android:textColor="@color/earthquake_text_secondary"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/backButton"
            app:layout_constraintEnd_toStartOf="@id/minutesPassedTV"
            app:layout_constraintStart_toEndOf="@id/magTV"
            app:layout_constraintTop_toBottomOf="@id/countryTV" />

        <TextView
            android:id="@+id/minutesPassedTV"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/earthquake_detail_chip_background"
            android:gravity="center"
            android:minWidth="76dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="10 min ago"
            android:textColor="@color/earthquake_accent_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/backButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/backButton" />

        <View
            android:id="@+id/detailDivider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/earthquake_stroke"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/backButton" />

        <TextView
            android:id="@+id/heroMagnitudeTV"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/earthquake_detail_magnitude_circle"
            android:gravity="center"
            android:text="4.2"
            android:textColor="@color/white"
            android:textSize="34sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/detailDivider" />

        <TextView
            android:id="@+id/magnitudeLabelTV"
            android:layout_width="92dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Magnitude"
            android:textColor="@color/earthquake_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/heroMagnitudeTV"
            app:layout_constraintTop_toBottomOf="@id/heroMagnitudeTV" />

        <TextView
            android:id="@+id/shakingStatusTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:text="Moderate shaking"
            android:textColor="@color/earthquake_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/heroMagnitudeTV"
            app:layout_constraintTop_toTopOf="@id/heroMagnitudeTV" />

        <TextView
            android:id="@+id/detailTimestampTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="11.05.2026 13:06"
            android:textColor="@color/earthquake_text_secondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/heroMagnitudeTV"
            app:layout_constraintTop_toBottomOf="@id/shakingStatusTV" />

        <LinearLayout
            android:id="@+id/metricsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/magnitudeLabelTV">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="86dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/earthquake_detail_metric_background"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_depth_24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Depth"
                        android:textColor="@color/earthquake_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/depthTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7 km"
                        android:textColor="@color/earthquake_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="86dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/earthquake_detail_metric_background"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_distance_24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Distance"
                        android:textColor="@color/earthquake_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/distanceTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="@color/earthquake_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="86dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/earthquake_detail_metric_background"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_calendar_24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Date"
                        android:textColor="@color/earthquake_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/dateTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="11 May"
                        android:textColor="@color/earthquake_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="86dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/earthquake_detail_metric_background"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_clock_24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Time"
                        android:textColor="@color/earthquake_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/timeTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="13:06"
                        android:textColor="@color/earthquake_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shareButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="18dp"
            android:text="Share"
            android:textColor="@color/earthquake_accent"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/earthquake_accent_soft"
            app:cornerRadius="22dp"
            app:icon="@drawable/ic_share_24"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/earthquake_accent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/metricsContainer" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/compactDetailsBar"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:layout_gravity="bottom"
        android:background="@drawable/earthquake_detail_sheet_background"
        android:elevation="14dp"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:visibility="gone">

        <View
            android:id="@+id/compactDragHandle"
            android:layout_width="44dp"
            android:layout_height="4dp"
            android:background="@drawable/earthquake_detail_drag_handle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/compactBackButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/earthquake_detail_icon_button_background"
            android:contentDescription="Back to earthquake list"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/back_arrow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/compactDragHandle" />

        <TextView
            android:id="@+id/compactMagTV"
            android:layout_width="56dp"
            android:layout_height="36dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/earthquake_detail_magnitude_pill"
            android:gravity="center"
            android:text="4.2"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/compactBackButton"
            app:layout_constraintStart_toEndOf="@id/compactBackButton"
            app:layout_constraintTop_toTopOf="@id/compactBackButton" />

        <TextView
            android:id="@+id/compactCountryTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Malatya, Turkey"
            android:textColor="@color/earthquake_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/compactSubtitleTV"
            app:layout_constraintEnd_toStartOf="@id/compactMinutesPassedTV"
            app:layout_constraintStart_toEndOf="@id/compactMagTV"
            app:layout_constraintTop_toTopOf="@id/compactBackButton"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/compactSubtitleTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Selected earthquake"
            android:textColor="@color/earthquake_text_secondary"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/compactBackButton"
            app:layout_constraintEnd_toStartOf="@id/compactMinutesPassedTV"
            app:layout_constraintStart_toEndOf="@id/compactMagTV"
            app:layout_constraintTop_toBottomOf="@id/compactCountryTV" />

        <TextView
            android:id="@+id/compactMinutesPassedTV"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/earthquake_detail_chip_background"
            android:gravity="center"
            android:minWidth="76dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="10 min ago"
            android:textColor="@color/earthquake_accent_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/compactBackButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/compactBackButton" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
