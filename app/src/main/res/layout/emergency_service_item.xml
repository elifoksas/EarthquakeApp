<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/whistle_card_background"
    android:minHeight="82dp"
    android:padding="14dp">

    <FrameLayout
        android:id="@+id/iconContainer"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/whistle_status_icon_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_phone_24"
            app:tint="@color/earthquake_accent" />
    </FrameLayout>

    <TextView
        android:id="@+id/categoryText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:includeFontPadding="false"
        android:textColor="@color/earthquake_text_secondary"
        android:textSize="13sp"
        app:layout_constraintBottom_toTopOf="@id/numberText"
        app:layout_constraintEnd_toStartOf="@id/callButton"
        app:layout_constraintStart_toEndOf="@id/iconContainer"
        app:layout_constraintTop_toTopOf="@id/iconContainer"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Police · Fire · Ambulance" />

    <TextView
        android:id="@+id/numberText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="3dp"
        android:includeFontPadding="false"
        android:textColor="@color/earthquake_text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/iconContainer"
        app:layout_constraintEnd_toStartOf="@id/callButton"
        app:layout_constraintStart_toEndOf="@id/iconContainer"
        app:layout_constraintTop_toBottomOf="@id/categoryText"
        tools:text="112" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/callButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:minWidth="76dp"
        android:text="@string/emergency_numbers_call"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:backgroundTint="@color/earthquake_accent"
        app:cornerRadius="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
