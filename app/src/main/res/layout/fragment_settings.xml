<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp"
    tools:context=".ui.fragment.SettingsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/Settings"
            android:textColor="@color/earthquake_text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:includeFontPadding="false"
            android:text="@string/settings_subtitle"
            android:textColor="@color/earthquake_text_secondary"
            android:textSize="14sp" />

        <TextView
            style="@style/SettingsSectionLabel"
            android:layout_marginTop="34dp"
            android:text="@string/settings_section_filter" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/whistle_card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/settings_icon_background">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_earthquake_wave_24" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsItemTitle"
                        android:text="@string/SettingsMinimumMagnitudeTitle" />

                    <TextView
                        style="@style/SettingsItemSummary"
                        android:layout_marginTop="4dp"
                        android:text="@string/settings_minimum_magnitude_summary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/magnitudeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/settings_value_background"
                    android:gravity="center"
                    android:minWidth="54dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/earthquake_accent"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="1.0" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/magnitudeSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:max="90"
                android:progress="0"
                android:progressBackgroundTint="@color/earthquake_stroke"
                android:progressTint="@color/earthquake_accent"
                android:splitTrack="false"
                android:thumbTint="@color/earthquake_accent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/SettingsRangeLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/settings_magnitude_min" />

                <TextView
                    style="@style/SettingsRangeLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="@string/settings_magnitude_max" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="62dp"
                android:layout_marginTop="14dp"
                android:background="@color/earthquake_stroke" />

            <LinearLayout
                android:id="@+id/distanceRangeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/settings_icon_background">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_distance_range_24" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsItemTitle"
                            android:text="@string/settings_distance_range_title" />

                        <TextView
                            android:id="@+id/distanceRangeSummary"
                            style="@style/SettingsItemSummary"
                            android:layout_marginTop="4dp"
                            tools:text="Show earthquakes within 100 km" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/distanceRangeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/settings_value_background"
                        android:gravity="center"
                        android:minWidth="64dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/earthquake_accent"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="100 km" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/distanceRangeSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:max="5"
                    android:progress="2"
                    android:progressBackgroundTint="@color/earthquake_stroke"
                    android:progressTint="@color/earthquake_accent"
                    android:splitTrack="false"
                    android:thumbTint="@color/earthquake_accent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-2dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/distanceRangeMinLabel"
                        style="@style/SettingsRangeLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        tools:text="25 km" />

                    <TextView
                        android:id="@+id/distanceRangeMaxLabel"
                        style="@style/SettingsRangeLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="@string/settings_all" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="62dp"
                android:background="@color/earthquake_stroke" />

            <LinearLayout
                android:id="@+id/depthRangeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/settings_icon_background">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_depth_range_24" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsItemTitle"
                            android:text="@string/settings_depth_range_title" />

                        <TextView
                            android:id="@+id/depthRangeSummary"
                            style="@style/SettingsItemSummary"
                            android:layout_marginTop="4dp"
                            tools:text="Show earthquakes up to 300 km deep" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/depthRangeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/settings_value_background"
                        android:gravity="center"
                        android:minWidth="64dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/earthquake_accent"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="300 km" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/depthRangeSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:max="5"
                    android:progress="4"
                    android:progressBackgroundTint="@color/earthquake_stroke"
                    android:progressTint="@color/earthquake_accent"
                    android:splitTrack="false"
                    android:thumbTint="@color/earthquake_accent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-2dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/depthRangeMinLabel"
                        style="@style/SettingsRangeLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        tools:text="10 km" />

                    <TextView
                        android:id="@+id/depthRangeMaxLabel"
                        style="@style/SettingsRangeLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="@string/settings_all" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/SettingsSectionLabel"
            android:layout_marginTop="24dp"
            android:text="@string/settings_section_notifications" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/whistle_card_background"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/quietHoursCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="88dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="12dp"
                android:paddingBottom="14dp">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/settings_icon_background">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_notifications_24" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsItemTitle"
                        android:text="@string/settings_earthquake_alerts_title" />

                    <TextView
                        style="@style/SettingsItemSummary"
                        android:layout_marginTop="4dp"
                        android:text="@string/settings_earthquake_alerts_summary" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/earthquakeNotificationsSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:button="@null"
                    app:thumbTint="@color/settings_switch_thumb"
                    app:trackTint="@color/settings_switch_track"
                    app:useMaterialThemeColors="false" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="78dp"
                android:background="@color/earthquake_stroke" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="88dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="12dp"
                android:paddingBottom="14dp">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/settings_icon_background">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_quiet_hours_24" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsItemTitle"
                        android:text="@string/settings_quiet_hours_title" />

                    <TextView
                        android:id="@+id/quietHoursSummary"
                        style="@style/SettingsItemSummary"
                        android:layout_marginTop="4dp"
                        tools:text="10:00 PM - 7:00 AM" />
                </LinearLayout>

                <TextView
                    android:id="@+id/quietHoursValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:includeFontPadding="false"
                    android:textColor="@color/earthquake_accent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Off" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right_24" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/SettingsSectionLabel"
            android:layout_marginTop="24dp"
            android:text="@string/settings_section_maps" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/whistle_card_background"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/mapTypeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="82dp"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/settings_icon_background">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_map_24" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsItemTitle"
                        android:text="@string/settings_map_type_title" />

                    <TextView
                        android:id="@+id/mapTypeValue"
                        style="@style/SettingsItemSummary"
                        android:layout_marginTop="4dp"
                        tools:text="Normal" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right_24" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="78dp"
                android:background="@color/earthquake_stroke" />

            <LinearLayout
                android:id="@+id/distanceUnitsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="82dp"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/settings_icon_background">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_distance_units_24" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsItemTitle"
                        android:text="@string/settings_distance_units_title" />

                    <TextView
                        android:id="@+id/distanceUnitsSummary"
                        style="@style/SettingsItemSummary"
                        android:layout_marginTop="4dp"
                        tools:text="Kilometers (km)" />
                </LinearLayout>

                <TextView
                    android:id="@+id/distanceUnitsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:includeFontPadding="false"
                    android:textColor="@color/earthquake_accent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="km" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right_24" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/SettingsSectionLabel"
            android:layout_marginTop="24dp"
            android:text="@string/settings_section_support" />

        <LinearLayout
            android:id="@+id/feedbackCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/whistle_card_background"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="82dp"
            android:orientation="horizontal"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/settings_icon_background">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_feedback_24" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/SettingsItemTitle"
                    android:text="@string/SettingsFeedbackTitle" />

                <TextView
                    style="@style/SettingsItemSummary"
                    android:layout_marginTop="4dp"
                    android:text="@string/settings_feedback_summary" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right_24" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
